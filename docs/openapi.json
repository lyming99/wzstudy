  "components": {
    "securitySchemes": {
      "AdminKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "ADMIN_API_KEY; management and read access"
      },
      "ReadKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "READ_API_KEY; published data only; admin key also accepted"
      },
      "SourceKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "Per-source one-time key, limited to its own ingest route"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
