{
  "openapi": "3.1.0",
  "info": {
    "title": "WzStudy 学习数据源 API",
    "version": "0.1.0",
    "description": "Independent backend. Bearer admin, read and per-source keys are separate. Admin may also read; admin cannot replace source key for ingestion. Error bodies never return secrets."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
