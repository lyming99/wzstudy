    "/changes": {
      "get": {
        "operationId": "get__changes",
        "summary": "Replay durable commit-ordered changes",
        "security": [
          {
            "ReadKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/ChangePage"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error; see error.code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 100
            },
            "description": "Global scan window; filtered result may be empty but advances cursor"
          },
          {
            "name": "source_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Comma-separated UUIDs; changing filter requires replay from 0"
            }
          }
        ]
      }
    },
    "/stream": {
      "get": {
        "operationId": "get__stream",
        "summary": "SSE change/checkpoint events with resume",
        "security": [
          {
            "ReadKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "SSE. Persist both change and checkpoint ids; reconnect with Last-Event-ID. Heartbeats every 10s, max connection ~30m.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "description": "Error; see error.code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 100
            },
            "description": "Global scan window; filtered result may be empty but advances cursor"
          },
          {
            "name": "source_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Comma-separated UUIDs; changing filter requires replay from 0"
            }
          },
          {
            "name": "Last-Event-ID",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/ingest/{source_id}": {
      "post": {
        "operationId": "post__ingest_source_id",
