# WzStudy 采集端配置
# 修改后保存；先运行 start-agent.ps1 doctor（或双击 start-agent.cmd）检查连接。
# 也可以直接编辑本文件后运行：wzstudy-agent.exe run

# 录入系统地址（wzstudy 服务端根地址，不要带 /api/v1）
WZSTUDY_SERVER_URL=http://127.0.0.1:8091

# 采集端密钥：在管理后台或管理 API 创建采集端时生成，只显示一次，以 wzag_ 开头。
# 管理后台入口：系统管理 → 采集任务 → 采集端（若未创建，请先用管理 API 创建）。
WZSTUDY_AGENT_KEY=wzag_请替换为采集端密钥

# 模型服务（OpenAI 兼容）。采集端用它执行 agent loop，服务端看不到这里的密钥。
AGENT_MODEL_BASE_URL=https://api.deepseek.com/v1
AGENT_MODEL_API_KEY=
AGENT_MODEL=deepseek-chat

# 可选配置（一般保持默认）
# AGENT_SKILLS_DIR=skills
# AGENT_POLL_SECONDS=5
# AGENT_WAIT_SECONDS=20
# AGENT_MAX_FETCH_BYTES=2097152
# AGENT_ALLOW_PRIVATE_NETWORK=false
# AGENT_LOG_LEVEL=info

# 可选：yt-dlp 可执行文件路径；留空时从 PATH 或 agent 当前目录查找 yt-dlp(\.exe)
AGENT_YTDLP_PATH=
# 单次媒体下载上限（字节），默认 200MB
AGENT_MEDIA_MAX_BYTES=209715200
