.env
.env.*
!.env.example
/bin/
/dist/
/.tmp/
/coverage.out
/.local/
/.artifacts/
/data/
# Compatibility with workspaces created before the root-level layout.
/internal/.local/
/internal/.artifacts/
/internal/data/
/internal/dist/
*.log
*.exe
__pycache__/
*.pyc

# 编译与构建产物（跨平台）
*.test
*.out
*.dll
*.so
*.dylib
*.a
*.o
*.pdb
*.zip
*.tar
*.tar.gz
*.tgz
*.msi
*.pprof
*.trace

# 临时与编辑器文件
*.tmp
*.temp
*.bak
*.orig
*.rej
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vs/
.pytest_cache/
