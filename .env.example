# Copy to .env and replace all three placeholders before docker compose up.
# Generate independent random values: python -c "import secrets; print(secrets.token_urlsafe(32))"
# POSTGRES_PASSWORD: use URL-safe random characters; percent-encode if using a custom password.
APP_ENV=production
POSTGRES_PASSWORD=
ADMIN_API_KEY=
READ_API_KEY=
API_PORT=8091
POLL_ENABLED=true
SSE_MAX_CLIENTS=128
# Exact origins separated by commas; production requires HTTPS. Empty disables browser cross-origin access.
CORS_ORIGINS=

# First administrator, matching wenzflow startup bootstrap. No public default credentials.
# Required only when creating the first administrator; remove the password after initialization if desired.
SYSTEM_ADMIN_EMAIL=
SYSTEM_ADMIN_PASSWORD=
SYSTEM_ADMIN_DISPLAY_NAME=
