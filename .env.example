# Copy to .env for local configuration. Never commit real credentials.
# start-local.ps1 starts its own PostgreSQL Docker instance. Generated local
# credentials are stored here with a private Windows ACL and are not printed.
# This file contains plaintext secrets: do not commit or share it; back it up securely.
# DATA_DIR stores media attachments, not the PostgreSQL database itself.
# Relative paths are resolved against the project root, not the shell directory.
DATA_DIR=.local/postgres-local/data

# Optional database settings for start-local.ps1. Leave both blank to generate
# a random database password and local connection automatically. Generated
# settings are written to .env and reused; this template is never modified.
# If provided, DATABASE_URL must refer to 127.0.0.1 or localhost and use only
# sslmode=disable (no TLS in the local container), for example:
# postgres://<user>:<URL-encoded-password>@127.0.0.1:15432/<database>?sslmode=disable
# The default launcher never connects to an external database; use
# scripts/start-dev.ps1 -Postgres and TLS for an external/production database.
DATABASE_URL=
# If both a URL password and POSTGRES_PASSWORD are set, they must match exactly.
# The separate root docker-compose.yml requires URL-safe POSTGRES_PASSWORD.
POSTGRES_PASSWORD=

# Leave both empty to generate two different local API keys in .env.
# Existing keys are retained; changing them can break API integrations.
ADMIN_API_KEY=
READ_API_KEY=
# Optional stable 32-256 character random secret for encrypting retained query
# client keys. Set BEFORE creating keys and back it up separately from the DB.
# If omitted, the service derives the encryption key from ADMIN_API_KEY instead.
# Changing/removing it makes existing encrypted copies unreadable; it does not
# invalidate their authentication hashes. Restore the original secret or paste
# the original query key again to save it under the new secret.
CLIENT_KEY_ENCRYPTION_KEY=
# The launcher also adds local volume identity/state fields automatically.
# Do not remove them while the local database exists.

# First administrator on an empty database, including start-local.ps1.
# Set both fields before the first launch; passwords are never printed.
# Leave both empty for the local launcher to generate initial credentials in .env.
# Existing accounts are not reset when these values change. Never commit .env.
SYSTEM_ADMIN_EMAIL=
SYSTEM_ADMIN_PASSWORD=
# SYSTEM_ADMIN_DISPLAY_NAME=

# Collection agent (server side). Enabled by default; set AGENT_ENABLED=false
# to remove /api/v1/agent/* and /api/v1/admin/agent/* entirely.
# AGENT_ENABLED=true
# AGENT_LEASE_SECONDS=300
# AGENT_HEARTBEAT_GRACE_SECONDS=90
# AGENT_TASK_DEFAULT_ITEMS=50
# AGENT_TASK_MAX_ITEMS=100
# AGENT_TASK_MAX_TIMEOUT_SECONDS=1800
# AGENT_EVENT_MAX_BYTES=8192
# AGENT_EVENT_TOTAL_BYTES=262144
